# ==========================================
# RecoverAI Configuration (.env.example)
# ==========================================

# LLM API Keys (Optional - Deterministic Fallback Mode works out-of-the-box without any keys)
GEMINI_API_KEY=
OPENAI_API_KEY=

# LLM Provider Selection ("auto", "gemini", "openai", or "fallback")
LLM_PROVIDER=auto
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# Database Configuration
DATABASE_URL=sqlite:///./recoverai.db

# Deterministic Policy Engine Default Guardrails
MAX_RETRIES=3
CONFIDENCE_THRESHOLD=0.65
COOLDOWN_HOURS=4
HIGH_VALUE_THRESHOLD_INR=50000.0
